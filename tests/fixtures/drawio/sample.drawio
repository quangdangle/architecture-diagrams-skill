<mxfile host="test" agent="architecture-diagrams tests">
  <diagram id="blocks" name="Blocks">
<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="cpu-group" value="" style="group" vertex="1" connectable="0" parent="1">
      <mxGeometry x="40" y="40" width="300" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="cpu" value="&lt;b&gt;CPU&lt;/b&gt;&lt;div&gt;RISC-V core&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cpu-group">
      <mxGeometry width="120" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="cache" value="L1 cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="cpu-group">
      <mxGeometry x="180" width="120" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="mux" value="" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;rotation=90;" vertex="1" parent="1">
      <mxGeometry x="400" y="60" width="100" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="gate" value="" style="shape=or;whiteSpace=wrap;html=1;direction=west;" vertex="1" parent="1">
      <mxGeometry x="560" y="40" width="40" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="and1" value="" style="shape=mxgraph.electrical.logic_gates.and;html=1;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="660" y="40" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="note" value="clock domain A" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;fontColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="40" y="160" width="140" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="ctrl" value="FSM" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="240" y="200" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="fancy" value="custom shape" style="shape=mxgraph.not_a_real_library.widget;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="400" y="200" width="120" height="60" as="geometry"/>
    </mxCell>
    <UserObject label="Bus bridge" tooltip="AXI to APB" id="bridge">
      <mxCell style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
        <mxGeometry x="600" y="200" width="120" height="60" as="geometry"/>
      </mxCell>
    </UserObject>
    <mxCell id="lane" value="Peripherals" style="swimlane;whiteSpace=wrap;html=1;startSize=23;" vertex="1" parent="1">
      <mxGeometry x="40" y="320" width="260" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="uart" value="UART" style="rounded=0;whiteSpace=wrap;html=1" vertex="1" parent="lane">
      <mxGeometry x="70" y="50" width="120" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cpu" target="cache">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;rounded=0;endSize=8;" edge="1" parent="1" source="cache" target="mux">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="400" y="250" as="sourcePoint"/>
        <mxPoint x="450" y="200" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="e3" value="sel" style="edgeStyle=segmentEdgeStyle;endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="ctrl" target="mux">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="450" y="290"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e4" style="endArrow=classic;html=1;dashed=1;dashPattern=1 3;strokeWidth=3;strokeColor=#FF3333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" target="note">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="20" y="175" as="sourcePoint"/>
        <mxPoint x="70" y="125" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="e5" style="endArrow=block;startArrow=oval;startFill=0;html=1;" edge="1" parent="1" source="bridge" target="uart">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="660" y="390"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e5-label" value="APB" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e5">
      <mxGeometry x="-0.2" relative="1" as="geometry">
        <mxPoint as="offset"/>
      </mxGeometry>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="compressed" name="Compressed page"></diagram>
</mxfile>
