      "steps": [
        {
          "node": "cpu",
          "text": "Reset is released and the CPU starts fetching instructions."
        },
        {
          "edge": [
            "axi",
            "rom"
          ],
          "text": "The first instructions come from the Boot ROM through the interconnect."
        },
        {
          "edge": [
            "qspi",
            "flash"
          ],
          "text": "Boot ROM code reads the bootloader from the external QSPI flash."
        },
        {
          "node": "ddrc",
          "text": "The bootloader trains the LPDDR4 interface so the DRAM can be used."
        },
        {
          "node": "npu",
          "text": "Linux starts and hands AI workloads to the NPU, which streams data from DRAM and SRAM."
        },
        {
          "edge": [
            "plic",
            "cpu"
          ],
          "text": "From then on, devices get the CPU's attention through the interrupt controller."
        }
      ],
