{
  "title": "Edge-AI SoC: block diagram, boot sequence and address map",
  "subtitle": "A hardware block diagram with a guided boot walkthrough, plus the address map.",
  "lang": "en",
  "diagrams": [
    {
      "id": "blocks",
      "title": "Block diagram",
      "tag": "Hardware",
      "summary": "Everything talks through one **AXI interconnect**: bus masters sit on top, memories and the APB bridge below it, slow peripherals behind the bridge. Use **Steps** to follow the boot sequence.",
      "direction": "TB",
      "groups": [
        {
          "id": "masters",
          "label": "Bus masters",
          "icon": "🧠",
          "color": "blue"
        },
        {
          "id": "fabric",
          "label": "Interconnect",
          "icon": "🔀",
          "color": "slate"
        },
        {
          "id": "memory",
          "label": "Memory",
          "icon": "💾",
          "color": "amber"
        },
        {
          "id": "periph",
          "label": "Peripherals on APB",
          "icon": "🔌",
          "color": "teal"
        }
      ],
      "nodes": [
        {
          "id": "cpu",
          "title": "RISC-V CPU cluster",
          "icon": "🧠",
          "desc": "Two 64-bit cores with L1 and L2 caches. Runs Linux and the control firmware.",
          "color": "blue",
          "group": "masters",
          "size": "lg"
        },
        {
          "id": "npu",
          "title": "NPU",
          "icon": "⚡",
          "desc": "Neural-network accelerator. Streams weights and activations over AXI.",
          "color": "violet",
          "group": "masters",
          "size": "lg"
        },
        {
          "id": "dma",
          "title": "DMA engine",
          "icon": "🔁",
          "desc": "Moves data between memory and devices so the CPU does not have to.",
          "color": "blue",
          "group": "masters"
        },
        {
          "id": "axi",
          "title": "AXI4 interconnect",
          "icon": "🔀",
          "desc": "Routes every read and write from the masters to memories and the APB bridge.",
          "color": "slate",
          "group": "fabric",
          "size": "lg",
          "ports": {
            "in": [
              "s_axi_cpu",
              "s_axi_npu",
              "s_axi_dma"
            ],
            "out": [
              "m_axi_rom",
              "m_axi_sram",
              "m_axi_ddr",
              "m_apb"
            ]
          }
        },
        {
          "id": "apb",
          "title": "AXI-to-APB bridge",
          "icon": "🌉",
          "desc": "Turns fast AXI transactions into simple APB accesses for slow devices.",
          "color": "slate",
          "group": "fabric"
        },
        {
          "id": "rom",
          "title": "Boot ROM",
          "icon": "🔒",
          "desc": "First code after reset. Checks and loads the bootloader.",
          "color": "amber",
          "group": "memory",
          "size": "sm"
        },
        {
          "id": "sram",
          "title": "On-chip SRAM",
          "icon": "🧊",
          "desc": "2 MB low-latency scratchpad for NPU tiles.",
          "color": "amber",
          "group": "memory",
          "size": "sm"
        },
        {
          "id": "ddrc",
          "title": "LPDDR4 controller",
          "icon": "💾",
          "desc": "Controller and PHY for the external DRAM.",
          "color": "amber",
          "group": "memory"
        },
        {
          "id": "uart",
          "title": "UART",
          "icon": "⌨️",
          "desc": "Debug console.",
          "color": "teal",
          "group": "periph",
          "size": "sm"
        },
        {
          "id": "qspi",
          "title": "QSPI controller",
          "icon": "📀",
          "desc": "Reads the external boot flash.",
          "color": "teal",
          "group": "periph",
          "size": "sm"
        },
        {
          "id": "gpio",
          "title": "GPIO",
          "icon": "🎚️",
          "desc": "Buttons, LEDs and board signals.",
          "color": "teal",
          "group": "periph",
          "size": "sm"
        },
        {
          "id": "plic",
          "title": "Interrupt controller",
          "icon": "🔔",
          "desc": "Collects device interrupts and signals the CPU.",
          "color": "teal",
          "group": "periph",
          "size": "sm"
        },
        {
          "id": "flash",
          "title": "QSPI flash",
          "icon": "🗄️",
          "desc": "Holds the bootloader and the firmware image.",
          "color": "slate",
          "external": true,
          "size": "sm"
        },
        {
          "id": "dram",
