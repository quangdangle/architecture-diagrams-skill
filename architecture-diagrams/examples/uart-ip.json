        {
          "name": "DATA",
          "offset": "0x00C",
          "width": 32,
          "desc": "Ghi để gửi một byte, đọc để lấy một byte đã nhận.",
          "fields": [
            {
              "bits": "7:0",
              "name": "DATA",
              "access": "RW",
              "reset": "0x00",
              "desc": "Byte dữ liệu."
            }
          ]
        },
        {
          "name": "IRQ_STATUS",
          "offset": "0x010",
          "width": 32,
          "desc": "Ví dụ viết theo định dạng reg của WaveDrom (liệt kê từ bit thấp).",
          "reg": [
