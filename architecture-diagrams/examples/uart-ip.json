      "steps": [
        {
          "edge": [
            "idle",
            "start"
          ],
          "text": "Khi rxd xuống 0, bộ thu nghi là có start bit và chuyển sang START."
        },
        {
          "node": "start",
          "text": "Bộ thu kiểm tra lại ở giữa start bit; nếu rxd đã lên 1 thì đó chỉ là nhiễu."
