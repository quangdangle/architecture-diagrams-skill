            {
              "bits": 3,
              "name": "RXOVF",
              "access": "W1C",
              "reset": "0",
              "desc": "Tràn RX FIFO, ghi 1 để xóa."
            },
            {
              "bits": 2,
              "name": "RXEMPTY",
              "access": "RO",
              "reset": "1",
              "desc": "RX FIFO rỗng."
            },
            {
              "bits": 1,
              "name": "TXEMPTY",
              "access": "RO",
              "reset": "1",
              "desc": "TX FIFO rỗng."
            },
            {
              "bits": 0,
              "name": "TXFULL",
              "access": "RO",
              "reset": "0",
              "desc": "TX FIFO đầy."
            }
          ]
        },
        {
          "name": "BAUD",
          "offset": "0x008",
          "width": 32,
          "desc": "Hệ số chia tốc độ baud.",
          "fields": [
            {
              "bits": "15:0",
              "name": "DIV",
              "access": "RW",
