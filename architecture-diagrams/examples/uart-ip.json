        {
          "from": "regs",
          "to": "rxfifo",
          "label": "đọc DATA",
          "kind": "main",
          "dir": "back"
        },
        {
          "from": "regs",
          "to": "baud",
          "label": "div"
        },
        {
          "from": "regs",
          "to": "irq",
          "label": "cờ trạng thái",
          "kind": "async"
        },
        {
          "from": "txfifo",
          "to": "tx",
          "label": "byte",
          "kind": "main"
        },
        {
          "from": "rxfifo",
          "to": "rx",
          "label": "byte nhận",
          "kind": "main",
          "dir": "back"
        },
        {
          "from": "baud",
          "to": "tx",
          "label": "tick_16x",
          "kind": "clock"
        },
        {
          "from": "baud",
          "to": "rx",
          "label": "tick_16x",
          "kind": "clock"
        },
        {
          "from": "tx",
          "to": "pins",
          "label": "txd"
        },
        {
          "from": "rx",
          "to": "pins",
          "label": "rxd",
          "dir": "back"
        }
      ],
      "steps": [
        {
          "node": "apb",
          "text": "CPU ghi một byte vào thanh ghi DATA qua bus APB."
        },
        {
          "node": "txfifo",
          "text": "Byte đi qua TX FIFO bất đồng bộ để sang miền UART_CLK an toàn."
        },
        {
          "node": "tx",
          "text": "Bộ phát thêm start bit, parity, stop bit rồi đẩy ra chân txd theo nhịp baud."
        },
        {
          "node": "rx",
          "text": "Ở chiều nhận, bộ thu lấy mẫu rxd 16 lần mỗi bit để chống nhiễu, rồi đưa byte vào RX FIFO."
        },
        {
          "node": "irq",
          "text": "Khi có byte mới hoặc có lỗi, logic ngắt bật irq để báo cho CPU."
        }
      ],
      "legend": {
        "colors": {
          "blue": "Miền PCLK",
          "amber": "Vượt miền clock",
          "teal": "Miền UART_CLK",
          "slate": "Bên ngoài chip"
        }
      }
    },
    {
      "id": "rx-fsm",
