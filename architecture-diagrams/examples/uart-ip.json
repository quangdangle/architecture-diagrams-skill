          {
            "name": "tx_busy",
            "wave": "01.........0"
          }
        ],
        "edge": [
          "a~>b lấy mẫu giữa start bit"
        ],
        "head": {
          "text": "Khung 8N1, mỗi cột là một bit",
          "tick": 0
        }
      }
    },
    {
      "id": "registers",
      "type": "register",
      "title": "Thanh ghi",
      "tag": "Register map",
      "summary": "Bản đồ thanh ghi của IP, mỗi thanh ghi rộng 32 bit. Các bit không liệt kê là **dự trữ**: đọc ra 0, ghi vào không có tác dụng.",
      "registers": [
        {
          "name": "CTRL",
          "offset": "0x000",
          "width": 32,
          "desc": "Điều khiển chung.",
          "fields": [
            {
              "bits": "15:8",
              "name": "RXTHR",
              "access": "RW",
              "reset": "0x01",
              "desc": "Ngưỡng số byte trong RX FIFO để báo ngắt."
            },
            {
              "bits": 5,
              "name": "STOP2",
              "access": "RW",
              "reset": "0",
              "desc": "1: dùng 2 stop bit."
            },
            {
              "bits": "4:3",
              "name": "PARITY",
              "access": "RW",
              "reset": "0",
              "desc": "0: không, 1: lẻ, 2: chẵn."
            },
            {
              "bits": 2,
              "name": "RXIE",
              "access": "RW",
              "reset": "0",
              "desc": "Cho phép ngắt khi có byte mới."
            },
            {
              "bits": 1,
              "name": "TXIE",
              "access": "RW",
              "reset": "0",
              "desc": "Cho phép ngắt khi TX FIFO trống."
            },
            {
              "bits": 0,
              "name": "EN",
              "access": "RW",
              "reset": "0",
              "desc": "Bật UART."
            }
          ]
        },
        {
          "name": "STATUS",
          "offset": "0x004",
          "width": 32,
          "desc": "Trạng thái FIFO và cờ lỗi.",
          "fields": [
            {
              "bits": "12:8",
              "name": "RXCNT",
              "access": "RO",
              "reset": "0",
              "desc": "Số byte đang có trong RX FIFO."
            },
            {
              "bits": 5,
              "name": "PERR",
              "access": "W1C",
              "reset": "0",
              "desc": "Lỗi parity, ghi 1 để xóa."
            },
            {
              "bits": 4,
              "name": "FERR",
              "access": "W1C",
              "reset": "0",
              "desc": "Lỗi khung, ghi 1 để xóa."
