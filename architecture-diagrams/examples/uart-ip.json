{
  "title": "IP UART: tài liệu thiết kế",
  "subtitle": "Ví dụ trọn bộ cho một IP vi mạch: sơ đồ khối, máy trạng thái, giản đồ thời gian và thanh ghi.",
  "lang": "vi",
  "diagrams": [
    {
      "id": "block",
      "title": "Sơ đồ khối",
      "tag": "Kiến trúc",
      "summary": "IP có hai **miền clock**: phần giao tiếp APB và thanh ghi chạy theo PCLK, phần phát và thu chạy theo UART_CLK. Hai **FIFO bất đồng bộ** ở giữa đưa dữ liệu qua ranh giới clock an toàn.",
      "direction": "TB",
      "groups": [
        {
          "id": "pclk",
          "label": "Miền PCLK",
          "icon": "🔷",
          "color": "blue"
        },
        {
          "id": "cdc",
          "label": "Vượt miền clock",
          "icon": "🔀",
          "color": "amber"
        },
        {
          "id": "uclk",
          "label": "Miền UART_CLK",
          "icon": "🔶",
          "color": "teal"
        }
      ],
      "nodes": [
        {
          "id": "apb",
          "title": "Giao tiếp APB",
          "icon": "🔌",
          "desc": "Nhận lệnh đọc ghi thanh ghi từ bus APB.",
          "color": "blue",
          "group": "pclk",
          "size": "lg",
          "ports": {
            "in": [
              "PCLK",
              "PRESETn",
              "PSEL",
              "PENABLE",
              "PWRITE",
              "PADDR[11:0]",
              "PWDATA[31:0]"
            ],
            "out": [
              "PRDATA[31:0]",
              "PREADY",
              "PSLVERR"
            ]
          }
        },
        {
          "id": "regs",
          "title": "Khối thanh ghi",
          "icon": "🗂️",
          "desc": "CTRL, STATUS, BAUD, DATA và IRQ_STATUS.",
          "color": "blue",
          "group": "pclk"
        },
        {
          "id": "irq",
          "title": "Logic ngắt",
          "icon": "🔔",
          "desc": "Gộp các nguồn ngắt thành một tín hiệu.",
          "color": "blue",
          "group": "pclk",
          "size": "sm",
          "ports": {
            "out": [
              "irq"
            ]
          }
        },
        {
          "id": "txfifo",
          "title": "TX FIFO bất đồng bộ",
          "icon": "📥",
          "desc": "16 byte, đưa dữ liệu từ PCLK sang UART_CLK.",
          "color": "amber",
          "group": "cdc"
        },
        {
          "id": "rxfifo",
          "title": "RX FIFO bất đồng bộ",
          "icon": "📤",
          "desc": "16 byte, đưa dữ liệu theo chiều ngược lại.",
          "color": "amber",
          "group": "cdc"
        },
        {
          "id": "baud",
          "title": "Bộ tạo baud",
          "icon": "⏱️",
          "desc": "Chia UART_CLK theo giá trị BAUD để tạo nhịp 16x.",
          "color": "teal",
          "group": "uclk",
          "size": "sm",
          "ports": {
            "in": [
              "uart_clk",
              "div[15:0]"
            ],
            "out": [
              "tick_16x"
            ]
          }
        },
        {
          "id": "tx",
          "title": "Bộ phát TX",
          "icon": "➡️",
          "desc": "Thêm start, parity, stop rồi dịch ra từng bit.",
          "color": "teal",
          "group": "uclk",
          "ports": {
            "out": [
              "txd"
            ]
          }
        },
        {
          "id": "rx",
          "title": "Bộ thu RX",
          "icon": "⬅️",
          "desc": "Lấy mẫu 16 lần mỗi bit rồi ghép lại thành byte.",
          "color": "teal",
          "group": "uclk",
          "ports": {
            "in": [
              "rxd"
            ]
          }
        },
        {
          "id": "pins",
          "title": "Chân UART",
          "icon": "📌",
          "desc": "txd và rxd nối ra ngoài chip.",
          "color": "slate",
          "external": true,
          "size": "sm"
        }
      ],
      "edges": [
