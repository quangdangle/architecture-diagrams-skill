    {
      "id": "apb-timing",
      "type": "wave",
      "title": "Giản đồ APB",
      "tag": "Timing",
      "summary": "Một lần **ghi** DATA có một chu kỳ chờ do PREADY xuống thấp, sau đó một lần **đọc** STATUS không chờ. Dữ liệu viết theo định dạng WaveJSON của WaveDrom.",
      "wave": {
        "signal": [
          {
            "name": "PCLK",
            "wave": "p......."
          },
          [
            "Điều khiển",
            {
              "name": "PSEL",
              "wave": "01..01.0"
            },
            {
              "name": "PENABLE",
              "wave": "0.1.0.10",
              "node": "..a....."
            },
            {
              "name": "PWRITE",
              "wave": "x1..x0.x"
            },
            {
              "name": "PREADY",
              "wave": "x.01x.1x",
              "node": "...b...."
            }
          ],
          [
            "Dữ liệu",
            {
              "name": "PADDR",
              "wave": "x3..x4.x",
              "data": [
                "0x00C DATA",
                "0x004 STATUS"
              ]
            },
            {
              "name": "PWDATA",
              "wave": "x5..x...",
              "data": [
                "0x41"
              ]
            },
            {
              "name": "PRDATA",
              "wave": "x.....6x",
              "data": [
                "0x06"
              ]
            }
          ]
        ],
        "edge": [
          "a~>b PREADY = 0 thêm 1 chu kỳ chờ"
        ],
        "head": {
          "text": "APB: ghi DATA rồi đọc STATUS",
          "tick": 0
        },
        "config": {
          "hscale": 2
        }
      }
    },
    {
      "id": "uart-frame",
