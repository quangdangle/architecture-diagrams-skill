      "notes": [
        {
          "id": "n1",
          "text": "Drew the inside of the UART: register interface, baud generator, TX/RX FIFOs, transmitter and receiver, wired to the APB port, with two serial ports o_tx and i_rx on the frame.\nRequest: draw the inside of this block from its ports",
          "kind": "change",
          "attach": "uart",
          "date": "2026-09-25",
          "by": "AI"
        },
        {
          "id": "n2",
          "text": "FIFO depth 16 bytes each; the RX FIFO raises an interrupt at half full.",
          "kind": "constraint",
          "attach": "rx_fifo",
          "date": "2026-09-25"
        },
        {
          "id": "n3",
          "text": "Does the DMA engine need its own APB port for its registers?",
          "kind": "question",
          "attach": "dma",
          "date": "2026-09-25"
        }
      ]
